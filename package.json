{
  "name": "chaste-businessos",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native Business Operating System for SMBs",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @chaste/db generate",
    "db:migrate": "tsx --env-file=.env packages/db/src/migrate.ts",
    "e2e": "pnpm --filter @chaste/api e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
