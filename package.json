{
  "name": "chaste-business-os",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "demo": "tsx --env-file-if-exists=.env scripts/demo-agent.ts",
    "demo:slice": "tsx --env-file-if-exists=.env scripts/demo-slice.ts",
    "format": "prettier --write .",
    "demo:m2": "tsx --env-file-if-exists=.env scripts/demo-m2.ts",
    "demo:m3": "tsx --env-file-if-exists=.env scripts/demo-m3.ts",
    "demo:m4": "tsx --env-file-if-exists=.env scripts/demo-m4.ts",
    "demo:m4b": "tsx --env-file-if-exists=.env scripts/demo-m4b.ts",
    "demo:m5": "tsx --env-file-if-exists=.env scripts/demo-m5.ts",
    "demo:m6": "tsx --env-file-if-exists=.env scripts/demo-m6.ts",
    "demo:support": "tsx --env-file-if-exists=.env scripts/demo-support.ts",
    "nl:test": "tsx --env-file-if-exists=.env scripts/nl-tasks.ts",
    "test:groq": "tsx --env-file-if-exists=.env scripts/test-groq.ts",
    "bench:agents": "tsx --env-file-if-exists=.env scripts/test-groq-agents.ts",
    "worker": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/worker.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "version": "0.2.0",
  "description": "The agentic ERP: describe your business, and an AI co-worker runs it under your authority",
  "license": "Apache-2.0"
}
