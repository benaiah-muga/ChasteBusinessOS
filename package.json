{
  "name": "chaste-business-os",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:vite": "pnpm --filter @chaste/web-vite dev",
    "dev:legacy": "pnpm --filter web dev",
    "dev:api": "node --env-file-if-exists=.env --run api:serve",
    "api:serve": "go -C apps/api run ./cmd/api",
    "db:provision-runtime": "node --env-file-if-exists=.env --run db:provision-runtime:cmd",
    "db:provision-runtime:cmd": "pnpm --filter @chaste/db db:provision-runtime",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "node --test scripts/migration/benchmark-startup.test.mjs && turbo test --concurrency=1 --output-logs=errors-only",
    "demo": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-agent.ts",
    "demo:slice": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-slice.ts",
    "format": "prettier --write .",
    "demo:m2": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m2.ts",
    "demo:m3": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m3.ts",
    "demo:m4": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m4.ts",
    "demo:m4b": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m4b.ts",
    "demo:m5": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m5.ts",
    "demo:m6": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m6.ts",
    "demo:support": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-support.ts",
    "demo:m7": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m7.ts",
    "demo:m8": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m8.ts",
    "nl:test": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/nl-tasks.ts",
    "test:groq": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/test-groq.ts",
    "bench:agents": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/test-groq-agents.ts",
    "worker": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/worker.ts",
    "go:test": "go -C apps/api test ./...",
    "go:vet": "go -C apps/api vet ./...",
    "go:verify": "pnpm go:test && pnpm go:vet",
    "benchmark:migration:builds": "node scripts/migration/benchmark-builds.mjs",
    "benchmark:migration:startup": "node scripts/migration/benchmark-startup.mjs",
    "migration:routes:generate": "node scripts/migration/route-ownership.mjs",
    "migration:routes:check": "node scripts/migration/route-ownership.mjs --check",
    "migration:contracts:generate": "node scripts/migration/api-contracts.mjs",
    "migration:contracts:check": "node scripts/migration/api-contracts.mjs --check",
    "migration:actions:generate": "node scripts/migration/server-action-manifest.mjs",
    "migration:actions:check": "node scripts/migration/server-action-manifest.mjs --check",
    "migration:data:generate": "node scripts/migration/data-table-manifest.mjs",
    "migration:data:check": "node scripts/migration/data-table-manifest.mjs --check",
    "migration:inventory:check": "node scripts/migration/check-continuity-inventory.mjs",
    "migration:capabilities:generate": "tsx --tsconfig scripts/migration/tsconfig.json scripts/migration/capability-manifest.ts",
    "migration:capabilities:check": "tsx --tsconfig scripts/migration/tsconfig.json scripts/migration/capability-manifest.ts --check",
    "demo:m9": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m9.ts",
    "demo:m10": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m10.ts",
    "demo:m11": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m11.ts",
    "demo:m11:isolated": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m11-isolated.ts",
    "demo:m12": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m12.ts",
    "demo:m13": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env scripts/demo-m13.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "version": "0.5.0",
  "description": "The agentic ERP: describe your business, and an AI co-worker runs it under your authority",
  "license": "Apache-2.0"
}
