{
  "name": "@chaste/module-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@chaste/db": "workspace:*",
    "@chaste/kernel": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": { "@types/nodemailer": "^6.4.17", "typescript": "^5.7.2", "vitest": "^2.1.8", "tsx": "^4.19.2" }
}
