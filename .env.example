# API
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Web (browser calls API)
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# Database (system PostgreSQL or Docker — both fine)
# Example with local Postgres:
#   createuser chaste && createdb -O chaste chaste
#   # or: sudo -u postgres createuser/createdb ...
DATABASE_URL=postgres://chaste:chaste@localhost:5432/chaste

# Redis
REDIS_URL=redis://localhost:6379

# Demo bootstrap (dev only)
CHASTE_BOOTSTRAP_DEMO=true
CHASTE_DEMO_ORG_NAME=Demo Company
CHASTE_DEMO_USER_EMAIL=owner@demo.local
CHASTE_DEMO_USER_NAME=Demo Owner

# AI (optional — without key, AI uses deterministic rule-based intent for demo)
OPENAI_API_KEY=
CHASTE_AI_MODEL=gpt-4o-mini

# Default autonomy: recommend | confirm | guarded_auto | full_autonomous
CHASTE_DEFAULT_AUTONOMY=confirm
