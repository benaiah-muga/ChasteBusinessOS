# ── Database (dev: docker container chaste-pgvector) ─────────────────────
DATABASE_URL="postgresql://chaste:chaste_dev@localhost:5433/chaste_os_v2"
# Dedicated Go runtime connection, provisioned by pnpm db:provision-runtime. Production must
# provide the matching CHASTE_APP_DB_PASSWORD and keep this role NOBYPASSRLS.
CHASTE_APP_DB_PASSWORD="chaste_app_dev_only"
GO_DATABASE_URL="postgresql://chaste_app:chaste_app_dev_only@localhost:5433/chaste_os_v2"
# Dedicated webhook dispatcher login, scoped to webhook outbox rows by RLS.
# Its password must differ from the app role password in production.
CHASTE_OUTBOX_WORKER_DB_PASSWORD="chaste_outbox_worker_dev_only"
OUTBOX_WORKER_DATABASE_URL="postgresql://chaste_outbox_worker:chaste_outbox_worker_dev_only@localhost:5433/chaste_os_v2"
# Separate Go campaign email worker login, limited to marketing email outbox rows and customer eligibility fields.
CHASTE_MARKETING_EMAIL_WORKER_DB_PASSWORD="chaste_marketing_email_worker_dev_only"
MARKETING_EMAIL_OUTBOX_WORKER_DATABASE_URL="postgresql://chaste_marketing_email_worker:chaste_marketing_email_worker_dev_only@localhost:5433/chaste_os_v2"
# Separate Go notification email worker login, limited to notification email outbox rows.
CHASTE_NOTIFICATION_EMAIL_WORKER_DB_PASSWORD="chaste_notification_email_worker_dev_only"
NOTIFICATION_EMAIL_OUTBOX_WORKER_DATABASE_URL="postgresql://chaste_notification_email_worker:chaste_notification_email_worker_dev_only@localhost:5433/chaste_os_v2"
# Dedicated Go capability jobs worker login, provisioned by pnpm db:provision-runtime.
# `pnpm worker` runs the Go jobs worker, which claims only its registered capabilities.
CHASTE_JOBS_WORKER_DB_PASSWORD="chaste_jobs_worker_dev_only"
JOBS_WORKER_DATABASE_URL="postgresql://chaste_jobs_worker:chaste_jobs_worker_dev_only@localhost:5433/chaste_os_v2"
# Internal capability assertion secret, generate with: openssl rand -hex 32
GO_INTERNAL_AUTH_SECRET=
# Direct Go session-authenticated GET /api/approvals for Vite; set to 0 with
# CHASTE_GO_APPROVALS_READ_ROUTE=0 to disable this Go handler. Vite still sends
# the request to Go, where an unmounted route returns 404.
GO_APPROVALS_READ_ROUTE=1
# Direct Go session-authenticated POST /api/approvals decisions for Vite; set
# to 0 with CHASTE_GO_APPROVALS_DECISION_ROUTE=0 to disable this Go handler.
GO_APPROVALS_DECISION_ROUTE=1
# Direct Go session-authenticated CRM collection reads for the Vite app.
GO_CRM_READ_ROUTE=1
GO_CRM_FOLLOW_UP_DRAFT_ROUTE=1 # session-authenticated Vite CRM follow-up drafting through Go
# Server gate for Go ingested-document list/preview reads. Documents requests stay Go-owned when disabled and return an error.
GO_DOCUMENT_INGESTED_READS=1
# Go read for authored-document version history and compare previews.
GO_DOCUMENTS_VERSION_READS=1
# Server gate for direct Go authored-document editor detail reads.
GO_DOCUMENTS_EDITOR_READS=1
# Server gate for direct Go authored-document draft, presence, and lock session writes.
GO_DOCUMENTS_EDITOR_WORKSPACE=1
# Server gate for the Go session-authenticated conversation presence route.
GO_MESSAGING_PRESENCE_ROUTE=1
# Server gate for direct Go messaging people reads; enabled by default, set to 0 to disable the capability (Vite lookups then fail closed).
GO_MESSAGING_PEOPLE_READS=1
GO_MESSAGE_ATTACHMENT_DOWNLOAD_ROUTE=1 # enables the session-authenticated GET /api/message-attachments/{id} route
# Go read for purchase requests and RFQ details; both workflow flags are enabled here, and setting either to 0 disables the Go route; Vite still sends API requests to Go.
GO_PURCHASING_WORKFLOW_READS=1 # enables purchasing.listPurchaseWorkflow for all authenticated Go capability clients; set 0 to disable the server capability; pair Vite CHASTE_GO_PURCHASING_WORKFLOW_READS=1
# Server gate for the Go accounts payable aging read; enabled by default, set to 0 to disable the capability (Vite lookups then fail closed).
GO_PURCHASING_AP_AGING_READS=1
GO_POS_SHIFT_SUMMARY_ROUTE="1" # direct session-authenticated POST /api/pos/shift-summary; set to 0 to disable this Go handler; Vite still sends API requests to Go
# Optional Go session-capability route for cycle-count create, record, post, and cancel; also requires GO_SESSION_CAPABILITY_ROUTE=1.
GO_INVENTORY_CYCLE_COUNT_WRITES=1
# Trusted Go API endpoint used by demo and verification scripts when
# CHASTE_GO_API_ORIGIN is not set. They forward browser Cookie and Authorization
# headers, so configure only the Go API you control. HTTPS may point to a
# remote/private service; cleartext HTTP is restricted to loopback.
GO_API_INTERNAL_URL=http://127.0.0.1:8080
GO_ONBOARDING_ROUTE="1" # Go is the only organization-creation writer; set to 0 to unmount the Go handler
GO_ORG_ROUTE="1" # Mount the session-authenticated Go /api/org handler by default; set to 0 only to unmount it
GO_ROUTINES_ROUTE="1" # Mount Go for exact GET/POST /api/routines; set to 0 to unmount the Go handler
GO_MEMORY_ROUTE="1" # Mount Go for exact GET/POST /api/memory; set to 0 to unmount the Go handler
CHASTE_GO_MEMORY_ROUTE="1" # Vite proxies exact GET/POST /api/memory to Go by default; set to 0 to bypass specialized routing; the catch-all still sends API requests to Go
GO_MODULE_SETTINGS_ROUTE="1" # Mount Go for exact GET/POST /api/module-settings; set to 0 to unmount the Go handler
CHASTE_GO_MODULE_SETTINGS_ROUTE="1" # Vite proxies exact GET/POST /api/module-settings to Go by default; set to 0 to bypass specialized routing; the catch-all still sends API requests to Go
GO_POLICY_ROUTE="1" # Mount Go for exact GET/POST /api/policy; set to 0 to unmount the Go handler
CHASTE_GO_POLICY_ROUTE="1" # Vite proxies exact GET/POST /api/policy to Go by default; set to 0 to bypass specialized routing; the catch-all still sends API requests to Go

# ── NVIDIA NIM (integrate.api.nvidia.com, OpenAI-compatible) ────────────
NVIDIA_API_KEY=""

NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Model routing (see ARCHITECTURE.md §5)
MODEL_PRIMARY="deepseek-chat"
MODEL_FAST="deepseek-chat"
MODEL_REASONING="deepseek-reasoner"
MODEL_EMBEDDINGS="nvidia/nv-embedqa-e5-v5"
MODEL_OCR="nvidia/nemotron-parse-v1.2"
EMBEDDING_DIMENSIONS=1024

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""   # generate: openssl rand -base64 32
# Explicit Go auth base URL for local verification and recovery links.
# Without it Go auth uses the local Vite origin on port 3000.
BETTER_AUTH_URL="http://localhost:3000"
# Go always owns authentication routes. Production deployments must set the
# mode and cookie/origin policy explicitly for their environment.
GO_AUTH_MODE="development" # development or production; required for Go auth
GO_AUTH_PUBLIC_ORIGIN="" # production requires an explicit HTTPS origin
GO_AUTH_SECURE_COOKIE="" # production requires true
GO_AUTH_TRUSTED_PROXY_CIDRS="" # only set to known reverse-proxy CIDRs
GO_OIDC_ENABLED="0" # optional Go OIDC sign-in
GO_OIDC_ISSUER="" # exact HTTPS issuer URL from the identity provider
GO_OIDC_CLIENT_ID=""
GO_OIDC_CLIENT_SECRET=""
GO_OIDC_REDIRECT_URI="" # exact registered https://api-host/api/auth/callback/oidc URL
GO_OIDC_NATIVE_REDIRECT_URI="" # optional exact app custom-scheme callback for native clients; empty disables native handoff
GO_OIDC_ALLOWED_ENDPOINT_HOSTS="" # exact host[:port] list for split-host provider endpoints, comma-separated
GO_OIDC_TRUST_VERIFIED_EMAIL="false" # set true only if this issuer is trusted to attest email_verified
GO_SAML_ENABLED="0" # optional Go SAML sign-in
GO_SAML_IDP_ISSUER=""
GO_SAML_IDP_SSO_URL="" # exact HTTPS identity-provider SSO endpoint
GO_SAML_IDP_SIGNING_CERT_PEM="" # pinned PEM signing certificate; provider must sign the response
GO_SAML_SP_ENTITY_ID=""
GO_SAML_ACS_URL="" # exact https://api-host/api/auth/callback/saml URL
GO_SAML_SUCCESS_URL="" # exact HTTPS post-login destination
GO_SAML_TRUST_VERIFIED_EMAIL="false" # set true only when the IdP is trusted to attest its email attribute
GO_SAML_EMAIL_ATTRIBUTE=""
GO_SAML_NAME_ATTRIBUTE=""
GO_API_TRUSTED_PROXY_CIDRS="" # exact trusted proxy peer CIDRs only when HTTPS terminates before Go; required to trust its forwarded scheme
GO_PORTAL_INVOICE_ROUTE="1" # public token-scoped GET /api/portal/invoice/{token}; defaults on, set to 0 to unmount
GO_SALES_INVOICE_ROUTE="1" # Go owns GET /api/sales/{orderId} by default; set 0 to unmount
GO_SALES_ORDERS_ROUTE="1" # direct session-authenticated GET /api/sales; defaults on, set to 0 to disable this Go handler; Vite still sends API requests to Go
GO_SUPPORT_CHANNELS_ROUTE="1" # Mount Go GET/POST /api/support/channels by default; set 0 to unmount
GO_SESSION_CAPABILITY_ROUTE="1" # local Vite development uses the direct session-authenticated governed capability endpoint
GO_MANUFACTURING_DEFINE_BOM_SLICE="1" # allow BOM definition/deletion capabilities on the Go session capability endpoint
GO_MODULES_ROUTE="1" # direct session-authenticated GET /api/modules switchboard; defaults on, set to 0 to disable this Go handler; Vite still sends API requests to Go
GO_MODULES_WRITE_ROUTE="1" # direct session-authenticated POST /api/modules switchboard
GO_PROJECTS_ROUTE="1" # direct session-authenticated GET/POST /api/projects; defaults on, set to 0 to disable this Go handler; Vite still sends API requests to Go
GO_TEAM_READ_ROUTE="1" # direct session-authenticated GET /api/team; defaults on, set to 0 to disable this Go handler; Vite still sends API requests to Go
GO_TEAM_WRITE_ROUTE="1" # direct session-authenticated POST /api/team; defaults on, set to 0 to disable this Go handler; Vite still sends API requests to Go
GO_SCIM_READ_ROUTE="1" # Go SCIM 2.0 collection and single-user reads
GO_SCIM_WRITE_ROUTE="1" # governed SCIM user provisioning and deactivation writes
GO_SCIM_TOKENS_ROUTE="1" # local Go owner for SCIM token management
GO_BRANDING_ROUTE="1" # direct session-authenticated GET/POST /api/branding
GO_ANALYTICS_ROUTE="1" # Go serves session-authenticated GET /api/analytics; set 0 to disable this Go handler; Vite still sends API requests to Go
GO_ANALYTICS_REPORT_ROUTE="1" # session-authenticated POST /api/analytics report generation; set 0 to disable this Go handler; Vite still sends API requests to Go
GO_DASHBOARD_ROUTE="1" # direct session-authenticated GET /api/dashboard; set both to 0 to disable the Go route; Vite still sends API requests to Go
GO_SETUP_ROUTE="1" # direct session-authenticated GET /api/setup; set both to 0 to disable the Go route; Vite still sends API requests to Go; mirror SMTP_HOST and PATH for matching checklist state
GO_MY_WORK_ROUTE="1" # direct session-authenticated GET /api/my-work
GO_MY_WORK_SUMMARY_ROUTE="1" # direct session-authenticated POST /api/my-work/summarize
GO_SIGNALS_ROUTE="1" # direct session-authenticated GET /api/signals
GO_SESSIONS_ROUTE="1" # session reads default on; set both to 0 to disable this Go handler; Vite still sends API requests to Go
GO_DURABLE_RUNS_ROUTE="1" # durable-run reads default on; set both to 0 to disable this Go handler; Vite still sends API requests to Go
GO_NOTIFICATIONS_ROUTE="1" # direct session-authenticated GET /api/notifications
GO_SEARCH_ROUTE="1" # permission-aware cross-record search for the command palette
GO_SESSION_REVERT_ROUTE="1" # POST /api/sessions/{id}/revert for declared inverse actions
GO_NOTIFICATIONS_WRITE_ROUTE="1" # governed read-receipt writes for POST /api/notifications
GO_LEDGER_ROUTE="1" # direct session-authenticated GET /api/ledger
GO_INVENTORY_READ_ROUTE="1" # direct session-authenticated GET /api/inventory, including sku history via inventory.itemHistory; set to 0 to unmount; all Vite API requests still go to Go
GO_METRICS_ROUTE="1" # direct session-authenticated GET /api/metrics; defaults on, set to 0 to disable this Go handler; Vite still sends API requests to Go
GO_POS_READ_ROUTE="1" # direct session-authenticated GET /api/pos; set both POS read selectors to 0 to disable the Go route; Vite still sends API requests to Go
GO_POS_CUSTOMERS_ROUTE="1" # direct verified-session GET /api/pos/customers; set to 0 to unmount
GO_SUPPORT_CUSTOMERS_ROUTE="1" # verified-session GET /api/support/customers; set to 0 to unmount
GO_SUPPORT_REPLY_DRAFT_ROUTE="1" # verified-session POST /api/support/draft; set to 0 to unmount
GO_SUPPORT_PUBLIC_ROUTE="1" # public widget actions at POST /api/support/public
GO_SUPPORT_TRUSTED_PROXY_CIDRS="" # production: list exact Vite/edge proxy peer CIDRs so X-Forwarded-For rate limits use client IP; never trust client-supplied headers directly
GO_SUPPORT_EMBEDDING_WORKER="0" # opt-in worker for published support article embeddings
GO_SUPPORT_EMBEDDING_MODEL="nvidia/nv-embedqa-e5-v5" # support search and indexing model
# Enable each CHASTE_GO_* proxy flag only with the matching GO_* API mount flag above.
# These are configured separately because Vite and the Go API run as separate processes.
CHASTE_GO_API_ORIGIN="http://127.0.0.1:8080"
CHASTE_GO_SALES_ORDERS_ROUTE="1" # pair with GO_SALES_ORDERS_ROUTE=1 for exact GET /api/sales; set to 0 to disable this Go handler; Vite still sends API requests to Go
CHASTE_GO_SUPPORT_REPLY_DRAFT_ROUTE="1" # Vite support reply drafts use the authenticated Go route; set 0 to bypass the specialized selector; Vite still sends API requests to Go
CHASTE_GO_SESSION_CAPABILITY_ROUTE="1"
CHASTE_GO_INVENTORY_ITEM_SLICE="1" # Vite inventory item writes, including POS quick add and opening stock, use the Go capability endpoint; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_PURCHASING_PAYMENT_RUNS="1" # Vite supplier payment runs and bill eligibility use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to disable Vite payment run actions
CHASTE_GO_MODULES_ROUTE="1" # Vite routes GET /api/modules to Go by default; set to 0 to disable this Go handler; Vite still sends API requests to Go
CHASTE_GO_PROJECTS_ROUTE="1" # Vite routes GET/POST /api/projects to Go by default; set to 0 to disable this Go handler; Vite still sends API requests to Go
CHASTE_GO_PROJECTS_WRITES="1" # Vite project create/archive/task writes use direct Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/projects, which remains Go-backed while CHASTE_GO_PROJECTS_ROUTE=1
CHASTE_GO_TEAM_READ_ROUTE="1" # Vite routes GET /api/team to Go by default; set to 0 to disable this Go handler; Vite still sends API requests to Go
CHASTE_GO_TEAM_WRITE_ROUTE="1" # Vite routes POST /api/team to Go by default; set to 0 to disable this Go handler; Vite still sends API requests to Go
CHASTE_GO_ANALYTICS_ROUTE="1" # Vite sends exact GET /api/analytics requests to Go; set either selector to 0 to bypass specialized proxy selection; Vite still sends API requests to Go
CHASTE_GO_ANALYTICS_REPORT_ROUTE="1" # exact POST /api/analytics report generation; set 0 to bypass the specialized selector; Vite still sends API requests to Go, pair with GO_ANALYTICS_REPORT_ROUTE=1
CHASTE_GO_MY_WORK_ROUTE="1" # pair with GO_MY_WORK_ROUTE=1 for GET /api/my-work
CHASTE_GO_SIGNALS_ROUTE="1" # pair with GO_SIGNALS_ROUTE=1 for GET /api/signals
CHASTE_GO_SESSIONS_ROUTE="1" # session list, detail, and replay proxy defaults on; set both to 0 to disable this Go handler; Vite still sends API requests to Go
CHASTE_GO_DURABLE_RUNS_ROUTE="1" # durable-run list and detail proxy defaults on; set both to 0 to disable this Go handler; Vite still sends API requests to Go
CHASTE_GO_DASHBOARD_ROUTE="1" # Vite sends GET /api/dashboard to Go by default; set both to 0 to disable the Go route; Vite still sends API requests to Go
CHASTE_GO_APPROVALS_READ_ROUTE="1" # Vite sends only GET /api/approvals to Go; set both to 0 to disable the Go route; Vite still sends API requests to Go
CHASTE_GO_APPROVALS_DECISION_ROUTE="1" # Vite sends only POST /api/approvals decisions to Go; set both to 0 to disable the Go route; Vite still sends API requests to Go
CHASTE_GO_SETUP_ROUTE="1" # Vite sends GET /api/setup to Go by default; set both to 0 to disable the Go route; Vite still sends API requests to Go
CHASTE_GO_CRM_READS="1" # Vite CRM reads use Go, including GET /api/customers when GO_CRM_READ_ROUTE=1; set 0 to bypass specialized routing; the catch-all still sends API requests to Go
CHASTE_GO_CRM_FOLLOW_UP_DRAFT_ROUTE="1" # Vite CRM follow-up drafts use the Go session route; set 0 to bypass the specialized selector; Vite still sends API requests to Go
CHASTE_GO_METRICS_ROUTE="1" # Vite routes GET /api/metrics to Go by default; set to 0 to disable this Go handler; Vite still sends API requests to Go
LOG_LEVEL="info"

# Optional native coding-plan runtime. Codex CLI should be available as
# `codex` on PATH or set CODEX_BIN to its executable. Go requires the absolute,
# shared persistent directory used by the app for per-user Codex sign-ins.
CODEX_BIN=""
CHASTE_CODEX_CONNECTION_HOME=""

# ── Notifications (all optional; console always logs) ───────────────────
# Webhook: Slack/Discord/Zapier-compatible JSON POST for approvals + tickets
NOTIFICATION_WEBHOOK_URL=""
# Public app origin used for invoice links sent by bearer clients. Cookie-authenticated
# browser requests use their validated same-origin URL when this is empty.
GO_PUBLIC_APP_URL=""
# Email behind the same NotificationSink; requires SMTP_HOST and SMTP_TO
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="chaste@localhost"
SMTP_TO=""
# Go auth verification and recovery emails use SMTP_HOST, SMTP_PORT, SMTP_SECURE,
# SMTP_USER, SMTP_PASS, and SMTP_FROM. SMTP_TO is for notification email only.

# ── Model provider override ─────────────────────────────────────────────
# Default is DeepSeek. Set to "nvidia" to route chat through NVIDIA NIM,
# "openrouter" for OpenRouter, "groq" for Groq, "mistral" for Mistral, or
# "zai" for a GLM model; MODEL_PRIMARY then names that provider's model.
# NVIDIA is still used for embeddings unless another embedding provider is set.
MODEL_PROVIDER="deepseek"
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# DeepSeek chat and live agent evaluations in Settings > Quality.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Agent-loop context budgeting: compaction triggers at contextWindow minus
# reserve so larger-window models keep more history before folding.
MODEL_CONTEXT_WINDOW="131072"
