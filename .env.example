# ── Database (dev: docker container chaste-pgvector) ─────────────────────
DATABASE_URL="postgresql://chaste:chaste_dev@localhost:5433/chaste_os_v2"
# Dedicated Go runtime connection, provisioned by pnpm db:provision-runtime. Production must
# provide the matching CHASTE_APP_DB_PASSWORD and keep this role NOBYPASSRLS.
CHASTE_APP_DB_PASSWORD="chaste_app_dev_only"
GO_DATABASE_URL="postgresql://chaste_app:chaste_app_dev_only@localhost:5433/chaste_os_v2"
# Dedicated webhook dispatcher login, scoped to webhook outbox rows by RLS.
# Its password must differ from the app role password in production.
CHASTE_OUTBOX_WORKER_DB_PASSWORD="chaste_outbox_worker_dev_only"
OUTBOX_WORKER_DATABASE_URL="postgresql://chaste_outbox_worker:chaste_outbox_worker_dev_only@localhost:5433/chaste_os_v2"
# Optional Go capability jobs worker login, provisioned by pnpm db:provision-runtime.
# The legacy `pnpm worker` remains the default queue owner until parity gates pass.
CHASTE_JOBS_WORKER_DB_PASSWORD="chaste_jobs_worker_dev_only"
JOBS_WORKER_DATABASE_URL="postgresql://chaste_jobs_worker:chaste_jobs_worker_dev_only@localhost:5433/chaste_os_v2"
# Temporary Go session bridge secret, generate with: openssl rand -hex 32
GO_INTERNAL_AUTH_SECRET=
# Enable read-only Go policy comparison in development only.
GO_POLICY_SHADOW=0
# Optional policy GET read owner; requires the Go API and a trusted internal URL.
GO_POLICY_READ=0
# Compare the ledger read during development without changing its legacy response.
GO_LEDGER_SHADOW=0
# Optional ledger GET read owner; requires the Go API and a trusted internal URL.
GO_LEDGER_READ=0
# Optional organization switch membership/cookie owner; defaults to the legacy route.
GO_ORG_SWITCH=0
# Optional Projects POST write dispatch; defaults to the legacy capability executor.
GO_PROJECTS_WRITE=0
# Optional Projects GET read owner; defaults to the legacy handler.
GO_PROJECTS_READ=0
# Compare the unaudited project collection read during development only.
GO_PROJECTS_SHADOW=0
# Optional approval decision dispatch; defaults to the legacy decision service.
GO_APPROVAL_DECISION=0
# Optional signed Go approvals inbox/history read; defaults to the legacy handler.
GO_APPROVALS_READ=0
# Optional Go invoice creation; other accounting actions remain on the legacy executor.
GO_ACCOUNTING_CREATE_INVOICE=0
# Optional signed Go read for the governed invoice list in GET /api/accounting.
GO_ACCOUNTING_INVOICE_READS=0
# Optional signed Go read for customer statements in POST /api/accounting.
GO_ACCOUNTING_CUSTOMER_STATEMENT_READS=0
# Optional signed Go read for the combined accounting reports endpoint.
GO_ACCOUNTING_REPORTS_READ=0
# Optional signed Go dispatch for deal create, stage move, and lead conversion; defaults to the legacy executor.
GO_CRM_DEAL_WRITES=0
# Optional signed Go read for the deals list; defaults to the legacy handler.
GO_CRM_DEAL_READS=0
# Optional signed Go read for saved customer views; defaults to the legacy handler.
GO_CRM_VIEW_READS=0
# Optional signed Go read for CRM customer timelines; defaults to the legacy executor.
GO_CRM_TIMELINE_READS=0
# Direct Go session-authenticated CRM collection reads for the Vite app.
GO_CRM_READ_ROUTE=1
# Optional signed Go dispatch for saving CRM views; defaults to the legacy executor.
GO_CRM_VIEW_WRITES=0
# Signed Go dispatch for CRM task create, complete, and detail updates; set to 0 to use the legacy executor.
GO_CRM_TASK_WRITES=1
# Optional signed Go dispatch for sales order create, confirm, deliver, and cancel; defaults to the legacy executor.
GO_SALES_WRITE=0
# Optional signed Go read for sales order listing; defaults to the legacy executor.
GO_SALES_LIST_ORDERS_READS=0
# Optional signed Go read for authored documents; templates stay on the legacy executor.
GO_DOCUMENTS_LIST_READS=0
# Optional signed Go read for ingested documents list/detail; defaults to the legacy handler.
GO_DOCUMENT_INGESTED_READS=0
# Optional signed Go read for authored document version history; defaults to the legacy executor.
GO_DOCUMENTS_VERSION_READS=0
# Optional signed Go dispatch for quote create, accept, decline, and expire; defaults to the legacy executor.
GO_ACCOUNTING_QUOTES_WRITE=0
# Optional signed Go read for accounting quote listing; defaults to the legacy executor.
GO_ACCOUNTING_QUOTES_READS=0
# Optional signed Go dispatch for recording invoice payments; defaults to the legacy executor.
GO_ACCOUNTING_RECORD_PAYMENT_WRITE=0
# Optional signed Go dispatch for reversing invoice payments; defaults to the legacy executor.
GO_ACCOUNTING_REVERSE_PAYMENT_WRITE=0
# Optional signed Go dispatch for recording FX rates; defaults to the legacy executor.
GO_ACCOUNTING_FX_RATE_WRITE=0
# Optional signed Go dispatch for month-end foreign receivables revaluation; defaults to the legacy executor.
GO_ACCOUNTING_FX_REVALUATION_WRITE=0
# Optional signed Go dispatch for recurring invoice template create, pause, and resume; defaults to the legacy executor.
GO_ACCOUNTING_RECURRING_WRITE=0
# Optional signed Go dispatch for employee hire, deactivate, and structure updates; defaults to the legacy executor.
GO_HR_EMPLOYEE_WRITES=0
# Optional signed Go dispatch for expense claim submit, decision, and payment; defaults to the legacy executor.
GO_ACCOUNTING_EXPENSE_WRITES=0
# Optional signed Go dispatch for expense claim and policy reads; defaults to the legacy executor.
GO_ACCOUNTING_EXPENSE_READS=0
# Optional signed Go dispatch for vendor and bill creation and bill payments; defaults to the legacy executor.
GO_PURCHASING_BILL_WRITES=0
# Optional signed Go dispatch for purchase order creation; defaults to the legacy executor.
GO_PURCHASING_PO_WRITES=0
# Optional signed Go dispatch for closing purchase orders; defaults to the legacy executor.
GO_PURCHASING_PO_CLOSE_WRITES=0
# Optional signed Go dispatch for supplier bill credit notes; defaults to the legacy executor.
GO_PURCHASING_BILL_CREDIT_WRITES=0
# Optional signed Go dispatch for reversing supplier bill payments; defaults to the legacy executor.
GO_PURCHASING_REVERSE_VENDOR_PAYMENT_WRITE=0
# Optional signed Go read for purchase order receipt history; defaults to the legacy executor.
GO_PURCHASING_RECEIPT_READS=0
# Optional signed Go read for purchase requests and RFQ details; defaults to the legacy executor.
GO_PURCHASING_WORKFLOW_READS=0
# Optional signed Go read for the accounts payable aging report; defaults to the legacy executor.
GO_PURCHASING_AP_AGING_READS=0
# Optional signed Go dispatch for stock adjustments and transfer lifecycle writes; defaults to the legacy executor.
GO_INVENTORY_STOCK_WRITES=0
# Optional signed Go dispatch for inventory valuation summary posting; defaults to the legacy executor.
GO_INVENTORY_VALUATION_SUMMARY_WRITE=0
# Optional signed Go read for inventory item movement history; defaults to the legacy executor.
GO_INVENTORY_ITEM_HISTORY_READS=0
# Optional signed Go read for the main inventory stock report and reorder alerts; defaults to the legacy executor.
GO_INVENTORY_STOCK_REPORT_READS=0
# Optional signed Go read for the inventory transfer list; defaults to the legacy database read.
GO_INVENTORY_TRANSFER_READS=0
# Optional signed Go read for inventory lots; defaults to the legacy database read.
GO_INVENTORY_LOTS_READS=0
# Optional signed Go read for inventory reservations; defaults to the legacy database read.
GO_INVENTORY_RESERVATIONS_READS=0
# Optional signed Go read for inventory cycle counts; defaults to the legacy database read.
GO_INVENTORY_CYCLE_COUNTS_READS=0
# Optional signed Go read for inventory locations; defaults to the legacy database read.
GO_INVENTORY_LOCATIONS_READS=0
# Optional signed Go read for barcode lookup; defaults to the legacy executor.
GO_INVENTORY_BARCODE_LOOKUP_READS=0
# Optional signed Go dispatch for POS session, sale, return, close, and shift summary actions; defaults to the legacy executor.
GO_POS_WRITES=0
# Optional signed Go read for POS shift summaries; defaults to the legacy executor.
GO_POS_SHIFT_SUMMARY_READS=0
GO_POS_SHIFT_SUMMARY_ROUTE="1" # direct session-authenticated POST /api/pos/shift-summary; set to 0 for legacy-only behavior
# Optional signed Go dispatch for credit notes and journal entry reversals; defaults to the legacy executor.
GO_ACCOUNTING_INVOICE_OPS_WRITE=0
# Optional signed Go dispatch for bank accounts, feed imports, matching, exclusions, and transaction deletion; defaults to the legacy executor.
GO_BANKING_WRITES=0
# Optional signed Go dispatch for purchase requests, RFQs, quote recording, and award selection; defaults to the legacy executor.
GO_PURCHASING_REQUEST_WRITES=0
# Optional signed Go dispatch for item create, update, archive, and location creation; defaults to the legacy executor.
GO_INVENTORY_ITEM_WRITES=0
# Optional Go session-capability route for cycle-count create, record, post, and cancel; also requires GO_SESSION_CAPABILITY_ROUTE=1.
GO_INVENTORY_CYCLE_COUNT_WRITES=1
# Optional signed Go dispatch for budget scenario create and restore; defaults to the legacy executor.
GO_ACCOUNTING_BUDGET_WRITES=0
# Optional signed Go dispatch for period-close reads, checklist updates, close, and reopen; defaults to the legacy executor.
GO_ACCOUNTING_PERIOD_CLOSE_WRITES=0
# Optional signed Go dispatch for sales tax return filing; defaults to the legacy executor.
GO_ACCOUNTING_TAX_RETURNS_WRITE=0
# Optional signed Go dispatch for leave requests, decisions, cancellation, and clock in/out; defaults to the legacy executor.
GO_HR_LEAVE_TIME_WRITES=0
# Optional signed Go dispatch for payroll run create, execute, void, and the applicant pipeline; defaults to the legacy executor.
GO_HR_PAYROLL_APPLICANT_WRITES=0
# Optional signed Go dispatch for catalog imports and inventory reservations; defaults to the legacy executor.
GO_INVENTORY_IMPORT_WRITES=0
GO_INVENTORY_RESERVATION_WRITES=0
# Optional signed Go dispatch for customer imports and their undo path; defaults to the legacy executor.
GO_CRM_IMPORT_WRITES=0
# Optional signed Go dispatch for customer create, deactivate, merge, undo, and profile update; defaults to the legacy executor.
GO_CRM_CUSTOMER_WRITES=0
# Optional signed Go dispatch for Team & Roles reads and writes; defaults to the legacy executor.
GO_IAM_TEAM=0
# Optional signed Go dispatch for supplier payment-run lifecycle writes; keeps its existing GET bridge behavior.
GO_PURCHASING_PAYMENT_RUN_WRITES=0
# Optional signed Go dispatch for supplier payment-run reads; defaults to the legacy executor.
GO_PURCHASING_PAYMENT_RUN_READS=0
# Optional signed Go dispatch for vendor returns; defaults to the legacy executor.
GO_PURCHASING_RETURN_WRITES=0
# Optional signed Go dispatch for the supplier AP aging read; defaults to the legacy executor.
GO_PURCHASING_AP_AGING_READS=0
# Optional signed Go dispatch for job opening creation and closure; defaults to the legacy executor.
GO_HR_OPENINGS_WRITE=0
# Optional signed Go dispatch for payment reminder building; defaults to the legacy executor.
GO_ACCOUNTING_REMINDERS_READS=0
# Trusted Go API endpoint used by the Next compatibility proxy. The proxy forwards
# browser Cookie and Authorization headers, so configure only the Go API you control.
# HTTPS may point to a remote/private service; cleartext HTTP is restricted to loopback.
GO_API_INTERNAL_URL=http://127.0.0.1:8080
GO_ONBOARDING_ROUTE="1" # Go is the only organization-creation writer; Next POST proxies here without a TypeScript fallback

# ── NVIDIA NIM (integrate.api.nvidia.com, OpenAI-compatible) ────────────
NVIDIA_API_KEY=""

NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Model routing (see ARCHITECTURE.md §5)
MODEL_PRIMARY="moonshotai/kimi-k3"
MODEL_FAST="deepseek-ai/deepseek-v4-flash-0731"
MODEL_REASONING="nvidia/nemotron-3-super-120b-a12b"
MODEL_EMBEDDINGS="nvidia/nv-embedqa-e5-v5"
MODEL_OCR="nvidia/nemotron-parse-v1.2"
EMBEDDING_DIMENSIONS=1024

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""   # generate: openssl rand -base64 32
# Explicit base URL for Better Auth (verify-email links, callback redirects).
# Without it the origin is derived per-request and a WARN prints on boot.
BETTER_AUTH_URL="http://localhost:3000"
# Local development mounts Go authentication by default. Production deployments
# must set the mode and cookie/origin policy explicitly for their environment.
GO_AUTH_ROUTE="1"
GO_AUTH_MODE="development" # development or production; required while Go auth routing is enabled
GO_AUTH_PUBLIC_ORIGIN="" # production requires an explicit HTTPS origin
GO_AUTH_SECURE_COOKIE="" # production requires true
GO_AUTH_TRUSTED_PROXY_CIDRS="" # only set to known reverse-proxy CIDRs
GO_OIDC_ENABLED="0" # optional Go OIDC sign-in, requires GO_AUTH_ROUTE=1
GO_OIDC_ISSUER="" # exact HTTPS issuer URL from the identity provider
GO_OIDC_CLIENT_ID=""
GO_OIDC_CLIENT_SECRET=""
GO_OIDC_REDIRECT_URI="" # exact registered https://api-host/api/auth/callback/oidc URL
GO_OIDC_NATIVE_REDIRECT_URI="" # optional exact app custom-scheme callback for native clients; empty disables native handoff
GO_OIDC_ALLOWED_ENDPOINT_HOSTS="" # exact host[:port] list for split-host provider endpoints, comma-separated
GO_OIDC_TRUST_VERIFIED_EMAIL="false" # set true only if this issuer is trusted to attest email_verified
GO_SAML_ENABLED="0" # optional Go SAML sign-in, requires GO_AUTH_ROUTE=1
GO_SAML_IDP_ISSUER=""
GO_SAML_IDP_SSO_URL="" # exact HTTPS identity-provider SSO endpoint
GO_SAML_IDP_SIGNING_CERT_PEM="" # pinned PEM signing certificate; provider must sign the response
GO_SAML_SP_ENTITY_ID=""
GO_SAML_ACS_URL="" # exact https://api-host/api/auth/callback/saml URL
GO_SAML_SUCCESS_URL="" # exact HTTPS post-login destination
GO_SAML_TRUST_VERIFIED_EMAIL="false" # set true only when the IdP is trusted to attest its email attribute
GO_SAML_EMAIL_ATTRIBUTE=""
GO_SAML_NAME_ATTRIBUTE=""
GO_API_TRUSTED_PROXY_CIDRS="" # exact trusted Next proxy peer CIDRs only when HTTPS terminates before Go; required to trust its forwarded scheme
GO_PORTAL_INVOICE_ROUTE="1" # public token-scoped GET /api/portal/invoice/{token}
GO_SALES_INVOICE_ROUTE="1" # authenticated Go implementation of GET /api/sales/{orderId}
GO_SALES_ORDERS_ROUTE="1" # direct session-authenticated GET /api/sales; defaults on, set to 0 to roll back
GO_SUPPORT_CHANNELS_ROUTE="1" # Go support channel handler is mounted for Vite's separately selected methods
GO_SESSION_CAPABILITY_ROUTE="1" # local Vite development uses the direct session-authenticated governed capability endpoint
GO_MANUFACTURING_DEFINE_BOM_SLICE="0" # allow manufacturing.defineBom on the Go session capability endpoint
GO_MODULES_ROUTE="1" # direct session-authenticated GET /api/modules switchboard; defaults on, set to 0 to roll back
GO_MODULES_WRITE_ROUTE="1" # direct session-authenticated POST /api/modules switchboard
GO_PROJECTS_ROUTE="1" # direct session-authenticated GET/POST /api/projects; defaults on, set to 0 to roll back
GO_TEAM_READ_ROUTE="1" # direct session-authenticated GET /api/team; defaults on, set to 0 to roll back
GO_TEAM_WRITE_ROUTE="1" # direct session-authenticated POST /api/team; defaults on, set to 0 to roll back
GO_SCIM_READ_ROUTE="1" # Go SCIM 2.0 collection and single-user reads
GO_SCIM_WRITE_ROUTE="1" # governed SCIM user provisioning and deactivation writes
GO_SCIM_TOKENS_ROUTE="1" # local Go owner for SCIM token management
GO_BRANDING_ROUTE="1" # direct session-authenticated GET/POST /api/branding
GO_ANALYTICS_ROUTE="1" # Go serves session-authenticated GET /api/analytics; report POST remains on legacy
GO_DASHBOARD_ROUTE="1" # direct session-authenticated GET /api/dashboard
GO_SETUP_ROUTE="1" # direct session-authenticated GET /api/setup; keep SMTP_HOST and PATH aligned with the legacy app for matching checklist state
GO_MY_WORK_ROUTE="1" # direct session-authenticated GET /api/my-work
GO_MY_WORK_SUMMARY_ROUTE="1" # direct session-authenticated POST /api/my-work/summarize
GO_SIGNALS_ROUTE="1" # direct session-authenticated GET /api/signals
GO_SESSIONS_ROUTE="1" # session reads default on; set this and CHASTE_GO_SESSIONS_ROUTE to 0 for legacy fallback
GO_DURABLE_RUNS_ROUTE="1" # durable-run reads default on; set this and CHASTE_GO_DURABLE_RUNS_ROUTE to 0 for legacy fallback
GO_NOTIFICATIONS_ROUTE="1" # direct session-authenticated GET /api/notifications
GO_NOTIFICATIONS_WRITE_ROUTE="1" # governed read-receipt writes for POST /api/notifications
GO_LEDGER_ROUTE="1" # direct session-authenticated GET /api/ledger
GO_INVENTORY_READ_ROUTE="1" # direct session-authenticated GET /api/inventory, POST stays legacy
GO_METRICS_ROUTE="1" # direct session-authenticated GET /api/metrics; defaults on, set to 0 to roll back
GO_POS_READ_ROUTE="1" # direct session-authenticated GET /api/pos; set both POS read selectors to 0 for full rollback
GO_POS_CUSTOMERS_ROUTE="1" # direct verified-session GET /api/pos/customers; set to 0 to unmount
GO_SUPPORT_PUBLIC_ROUTE="1" # public widget actions at POST /api/support/public
GO_SUPPORT_TRUSTED_PROXY_CIDRS="" # production: list exact Vite/edge proxy peer CIDRs so X-Forwarded-For rate limits use client IP; never trust client-supplied headers directly
GO_SUPPORT_EMBEDDING_WORKER="0" # opt-in worker for published support article embeddings
GO_SUPPORT_EMBEDDING_MODEL="nvidia/nv-embedqa-e5-v5" # support search and indexing model
# Enable each CHASTE_GO_* proxy flag only with the matching GO_* API mount flag above.
# These are configured separately because Vite and the Go API run as separate processes.
CHASTE_GO_API_ORIGIN="http://127.0.0.1:8080"
CHASTE_GO_ONBOARDING_ROUTE="1" # Vite POST /api/onboarding goes directly to Go; unset or set 0 to use Next's strict Go proxy; GET/PATCH remain legacy
CHASTE_GO_AUTH_ROUTE="1" # auth namespace proxies to Go by default; set 0 only for legacy compatibility
CHASTE_GO_SCIM_READ_ROUTE="1" # pair with GO_SCIM_READ_ROUTE=1 for GET /api/scim/v2/Users and UUID user reads
CHASTE_GO_SCIM_WRITE_ROUTE="1" # pair with GO_SCIM_WRITE_ROUTE=1 for POST /api/scim/v2/Users and DELETE /api/scim/v2/Users/{uuid}
CHASTE_GO_PORTAL_INVOICE_ROUTE="1" # pair with GO_PORTAL_INVOICE_ROUTE=1 for public invoice links
CHASTE_GO_SALES_INVOICE_ROUTE="1" # pair with GO_SALES_INVOICE_ROUTE=1 for the invoice print view
CHASTE_GO_SALES_ORDERS_ROUTE="1" # pair with GO_SALES_ORDERS_ROUTE=1 for exact GET /api/sales; set to 0 to roll back
CHASTE_GO_SUPPORT_CHANNELS_ROUTE="1" # GET /api/support/channels; set 0 for legacy reads
CHASTE_GO_SUPPORT_CHANNELS_WRITE_ROUTE="1" # exact POST /api/support/channels; set 0 for legacy settings updates
CHASTE_GO_SUPPORT_PUBLIC_ROUTE="1" # pair with GO_SUPPORT_PUBLIC_ROUTE=1 to proxy the public support widget endpoint to Go
CHASTE_GO_SESSION_CAPABILITY_ROUTE="1"
CHASTE_GO_SALES_ORDER_WRITES="1" # Vite sales order create, deliver-all, and cancel use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_INVENTORY_ITEM_SLICE="1" # Vite inventory item writes, including POS quick add and opening stock, use the Go capability endpoint; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_INVENTORY_IMPORT_SLICE="1" # Vite product CSV import and undo use Go inventory capabilities with approval, idempotency, rate-limit, and onboarding behavior; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_INVENTORY_CYCLE_COUNT_WRITES="1" # Vite cycle-count create, record, post, and cancel use Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1 and GO_INVENTORY_CYCLE_COUNT_WRITES=1 on the API
CHASTE_GO_INVENTORY_TRANSFER_WRITES="1" # Vite inventory transfer create and confirm use Go capabilities with scoped retry IDs; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for legacy rollback
CHASTE_GO_INVENTORY_LOCATION_RESERVATION_WRITES="1" # Vite location creation and stock reservation/release use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for legacy rollback
CHASTE_GO_INVENTORY_BARCODE_LOOKUP="1" # Vite cycle-count barcode lookup uses inventory.lookupByBarcode through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/inventory
CHASTE_GO_CRM_DEAL_STAGE_MOVE="1" # Vite CRM deal stage changes use crm.moveDealStage through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/deals
CHASTE_GO_CRM_DEAL_CREATE="1" # Requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to keep fresh deal creation on /api/deals
CHASTE_GO_CRM_TASK_WRITES="1" # Vite CRM task creation, completion, and detail updates use Go capabilities; requires GO_CRM_TASK_WRITES=1 and CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to keep task writes on /api/crm
CHASTE_GO_CRM_CUSTOMER_CREATE="1" # Requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to keep customer creation on /api/customers
CHASTE_GO_CRM_CUSTOMER_DEACTIVATE="1" # Vite CRM customer deactivation uses crm.deactivateCustomer through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/customers
CHASTE_GO_CRM_CUSTOMER_MERGE="1" # Vite CRM customer merge and undo use crm.mergeCustomers and crm.restoreCustomerMerge through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/customers
CHASTE_GO_CRM_CUSTOMER_IMPORT="1" # Vite CRM customer CSV import and undo use crm.importCustomers and crm.undoCustomerImport through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/import
CHASTE_GO_CRM_CUSTOMER_PROFILE_UPDATE="1" # Requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to keep profile writes on /api/customers
CHASTE_GO_HR_EXPENSES="1" # Vite expense claim/policy reads and writes use accounting.* capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for explicit legacy rollback
CHASTE_GO_HR_LEAVE="1" # Vite HR Leave read and request/review/cancel writes use hr.* capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for explicit legacy rollback
CHASTE_GO_HR_TIME="1" # Vite HR Time report/queue reads and log/review writes use hr.* capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for explicit legacy rollback
CHASTE_GO_ACCOUNTING_RECORD_PAYMENT="1" # Vite invoice recordPayment writes use accounting.recordPayment through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for explicit legacy rollback
CHASTE_GO_ACCOUNTING_CREATE_INVOICE="1" # Vite invoice creation writes use accounting.createInvoice through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for explicit legacy rollback
CHASTE_GO_ACCOUNTING_CREDIT_NOTE="1" # Vite invoice credit notes use accounting.creditNote through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for explicit legacy rollback
CHASTE_GO_ACCOUNTING_REVERSE_ENTRY="1" # Vite manual/general journal reversals use accounting.reverseEntry through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for explicit legacy rollback
CHASTE_GO_BANK_RECONCILIATION_WRITES="1" # Vite bank match/unmatch writes use accounting.matchBankTransaction and accounting.unmatchBankTransaction through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for explicit legacy rollback
CHASTE_GO_PURCHASING_CREATE_ORDER="1" # Vite purchase order creation uses purchasing.createPurchaseOrder through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/purchasing
CHASTE_GO_PURCHASING_RECEIVE_GOODS="1" # Vite receipt submission uses purchasing.receiveGoods through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/purchasing
CHASTE_GO_PURCHASING_RETURN_CLOSE="1" # Vite return goods and purchase order close use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/purchasing
CHASTE_GO_PURCHASING_FINANCE_WRITES="1" # Vite vendor create, bill create, and bill payment use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/purchasing
CHASTE_GO_PURCHASING_PAYMENT_RUNS="1" # Vite supplier payment runs and bill eligibility use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to disable Vite payment run actions
CHASTE_GO_PURCHASING_SOURCING_WRITES="1" # Vite purchase requests, decisions, RFQs, quotes, and quote awards use Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to use /api/purchasing
CHASTE_GO_MARKETING_SEGMENT_SLICE="1" # Vite segment creation uses marketing.createSegment through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_MARKETING_CAMPAIGN_WRITES="0" # Vite campaign creation and sends use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 for legacy rollback
CHASTE_GO_MANUFACTURING_DEFINE_BOM_SLICE="0" # Vite BOM definition writes use Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1 and GO_MANUFACTURING_DEFINE_BOM_SLICE=1 on the API
CHASTE_GO_MANUFACTURING_WORK_ORDER_WRITES="1" # Vite work order create, release, completion, and cancellation use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_MANUFACTURING_PRODUCTION_WRITES="0" # Vite BOM production and production-run reversal use Go capabilities; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_MESSAGING_SEND_SLICE="1" # Vite sends in non-agent conversations use messaging.sendMessage through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_MESSAGING_EDIT_SLICE="0" # Vite message edits use messaging.editMessage through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_MESSAGING_DELETE_SLICE="0" # Vite message deletions use messaging.deleteMessage through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_POS_OPEN_SESSION_SLICE="1" # Vite POS register opening uses pos.openSession through Go when CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to roll back this action
CHASTE_GO_POS_CLOSE_SESSION_SLICE="1" # Vite POS register closing uses pos.closeSession through Go when CHASTE_GO_SESSION_CAPABILITY_ROUTE=1; set 0 to roll back this action
CHASTE_GO_POS_COMPLETE_SALE_SLICE="1" # Vite POS sales use pos.completeSale through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_POS_RETURN_SALE_SLICE="1" # Vite POS returns use pos.returnSale through Go; requires CHASTE_GO_SESSION_CAPABILITY_ROUTE=1
CHASTE_GO_MODULES_ROUTE="1" # Vite routes GET /api/modules to Go by default; set to 0 to roll back
CHASTE_GO_MODULES_WRITE_ROUTE="1" # pair with GO_MODULES_WRITE_ROUTE=1
CHASTE_GO_PROJECTS_ROUTE="1" # Vite routes GET/POST /api/projects to Go by default; set to 0 to roll back
CHASTE_GO_TEAM_READ_ROUTE="1" # Vite routes GET /api/team to Go by default; set to 0 to roll back
CHASTE_GO_TEAM_WRITE_ROUTE="1" # Vite routes POST /api/team to Go by default; set to 0 to roll back
CHASTE_GO_SCIM_TOKENS_ROUTE="1" # local selector paired with GO_SCIM_TOKENS_ROUTE=1
CHASTE_GO_BRANDING_ROUTE="1" # pair with GO_BRANDING_ROUTE=1
CHASTE_GO_ANALYTICS_ROUTE="1" # Vite sends exact GET /api/analytics requests to Go; set both flags to 0 for rollback
CHASTE_GO_MY_WORK_ROUTE="1" # pair with GO_MY_WORK_ROUTE=1 for GET /api/my-work
CHASTE_GO_MY_WORK_SUMMARY_ROUTE="1" # paired with GO_MY_WORK_SUMMARY_ROUTE=1 for POST /api/my-work/summarize
CHASTE_GO_SIGNALS_ROUTE="1" # pair with GO_SIGNALS_ROUTE=1 for GET /api/signals
CHASTE_GO_SESSIONS_ROUTE="1" # session list, detail, and replay proxy defaults on; set both paired flags to 0 for legacy fallback
CHASTE_GO_DURABLE_RUNS_ROUTE="1" # durable-run list and detail proxy defaults on; set both paired flags to 0 for legacy fallback
CHASTE_GO_NOTIFICATIONS_ROUTE="1" # pair with GO_NOTIFICATIONS_ROUTE=1 for notification reads
CHASTE_GO_NOTIFICATIONS_WRITE_ROUTE="1" # pair with GO_NOTIFICATIONS_WRITE_ROUTE=1 for governed notification read receipts
CHASTE_GO_DASHBOARD_ROUTE="1" # Vite sends GET /api/dashboard to Go; requires GO_DASHBOARD_ROUTE=1
CHASTE_GO_SETUP_ROUTE="1" # Vite sends GET /api/setup to Go; mirror SMTP_HOST and PATH between Next and Go
CHASTE_GO_LEDGER_ROUTE="1" # pair with GO_LEDGER_ROUTE=1 for GET /api/ledger
CHASTE_GO_INVENTORY_READ_ROUTE="1" # pair with GO_INVENTORY_READ_ROUTE=1 for GET /api/inventory only
CHASTE_GO_CRM_READS="1" # Vite CRM lists use the direct Go session-authenticated endpoint; set 0 to restore /api/deals, /api/customers, and /api/crm/views
CHASTE_GO_POS_READ_ROUTE="1" # pair with GO_POS_READ_ROUTE=1; set to 0 to send Vite POS reads to legacy, plus GO_POS_READ_ROUTE=0 to unmount Go
CHASTE_GO_POS_CUSTOMERS_SLICE="1" # Vite POS customer lookup uses the direct Go reader; set to 0 for legacy lookup
CHASTE_GO_POS_SHIFT_SUMMARY_ROUTE="1" # pair with GO_POS_SHIFT_SUMMARY_ROUTE=1; set both to 0 to use legacy POS shift-summary POST
CHASTE_GO_METRICS_ROUTE="1" # Vite routes GET /api/metrics to Go by default; set to 0 to roll back
LOG_LEVEL="info"

# Optional native coding-plan runtime. Codex CLI should be available as
# `codex` on PATH or set CODEX_BIN to its executable. Go requires the absolute,
# shared persistent directory used by the app for per-user Codex sign-ins.
CODEX_BIN=""
CHASTE_CODEX_CONNECTION_HOME=""

# ── Notifications (all optional; console always logs) ───────────────────
# Webhook: Slack/Discord/Zapier-compatible JSON POST for approvals + tickets
NOTIFICATION_WEBHOOK_URL=""
# Email behind the same NotificationSink; requires SMTP_HOST and SMTP_TO
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="chaste@localhost"
SMTP_TO=""
# Go auth verification and recovery emails use SMTP_HOST, SMTP_PORT, SMTP_SECURE,
# SMTP_USER, SMTP_PASS, and SMTP_FROM. SMTP_TO is for notification email only.

# ── Model provider override ─────────────────────────────────────────────
# Default is NVIDIA NIM. Set to "openrouter" to route chat through
# OPENROUTER_API_KEY instead (MODEL_PRIMARY then names an OpenRouter model).
# Set to "groq" to route through GROQ_API_KEY (MODEL_PRIMARY names a Groq model).
# Set to "mistral" to route through MISTRAL_API_KEY (MODEL_PRIMARY names a Mistral model).
# Set to "zai" to route through ZAI_API_KEY (MODEL_PRIMARY names a GLM model, e.g.
# glm-4.7-flash); override ZAI_BASE_URL for the bigmodel.cn endpoint.
MODEL_PROVIDER=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# Agent-loop context budgeting: compaction triggers at contextWindow minus
# reserve so larger-window models keep more history before folding.
MODEL_CONTEXT_WINDOW="131072"
