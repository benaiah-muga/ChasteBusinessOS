# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
HOST=0.0.0.0
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# ── Secrets & infrastructure (never commit real values) ──
# Prefer secret managers in production; inject as env vars.
# System PostgreSQL example (peer auth / local user):
#   DATABASE_URL=postgres://benaiah@/chaste?host=/var/run/postgresql
DATABASE_URL=postgres://benaiah@/chaste?host=/var/run/postgresql
REDIS_URL=redis://localhost:6379
CHASTE_SESSION_SECRET=dev-only-change-me-32chars!!

# ── Multi-region ─────────────────────────────────────────
CHASTE_REGION=local
CHASTE_REGIONS=local,us-east-1,eu-west-1,af-south-1

# ── Bootstrap admin (first run) ──────────────────────────
CHASTE_BOOTSTRAP=true
CHASTE_ORG_NAME=Primary Organization
CHASTE_ADMIN_EMAIL=admin@localhost
CHASTE_ADMIN_NAME=System Admin

# ── AI providers (config-driven; secrets via env) ────────
# none | openai | openai_compatible | ollama
CHASTE_AI_PROVIDER=none
CHASTE_AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# CHASTE_AI_BASE_URL=https://api.openai.com/v1
# Local LLM (Ollama):
# CHASTE_AI_PROVIDER=ollama
# CHASTE_AI_MODEL=llama3.2
# CHASTE_AI_BASE_URL=http://127.0.0.1:11434

# ── Autonomy ─────────────────────────────────────────────
CHASTE_DEFAULT_AUTONOMY=confirm
# Explicit platform allow-list for full autonomous mode
CHASTE_ALLOW_FULL_AUTONOMOUS=false
