    {
      "id": "harness.listCompositions",
      "title": "List harness compositions",
      "intent": "Inspect an organization's immutable harness compositions and their safe profile, bundle, and configuration key metadata.",
      "module": "settings",
      "risk": "read",
      "permission": "harness.approve",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "compositions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "inspection": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "environment": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "version",
                        "environment"
                      ],
                      "additionalProperties": false
                    },
                    "profileDigest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "compositionDigest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bundles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "serviceIds": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "requiredBundleIds": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "version",
                          "serviceIds"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "patches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "configKeys": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "version",
                          "configKeys"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "profile",
                    "profileDigest",
                    "compositionDigest",
                    "bundles",
                    "patches"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "createdAt",
                "inspection"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "compositions"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "iam.getOrgPolicy",
      "title": "Read org approval policy",
      "intent": "Read the organization's approval policy: the highest risk class that can run autonomously, the money threshold in minor units, and the risk classes that always need human approval. Use it to explain why an action needs approval or to propose a policy change.",
      "module": "iam",
      "risk": "read",
      "permission": "iam.read",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "maxRiskAutonomous": {
            "type": "string"
          },
          "moneyThresholdMinor": {
            "type": "number"
          },
          "requiresApprovalFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "maxRiskAutonomous",
          "moneyThresholdMinor",
          "requiresApprovalFor"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "iam.restoreAgentSoul",
      "title": "Restore agent persona",
      "intent": "Restore a previously captured organization agent persona after an authorized change. The previous persona is returned so the restore can be reversed again.",
      "module": "iam",
      "risk": "write",
      "permission": "iam.admin",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "iam.setAgentSoul",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "agentSoul": {
            "type": "string",
            "maxLength": 8000,
            "description": "Standing instructions, voice, and hard rules for every agent turn. An empty string clears the persona."
          }
        },
        "required": [
          "agentSoul"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "agentSoul": {
            "type": "string"
          },
          "previousAgentSoul": {
            "type": "string"
          }
        },
        "required": [
          "agentSoul",
          "previousAgentSoul"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "iam.setAgentSoul",
      "title": "Set agent persona",
      "intent": "Replace the organization's standing agent persona, the instructions every agent turn follows. The previous persona is returned so the change can be restored.",
      "module": "iam",
      "risk": "write",
      "permission": "iam.admin",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "iam.restoreAgentSoul",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "agentSoul": {
            "type": "string",
            "maxLength": 8000,
            "description": "Standing instructions, voice, and hard rules for every agent turn. An empty string clears the persona."
          }
        },
        "required": [
          "agentSoul"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "agentSoul": {
            "type": "string"
          },
          "previousAgentSoul": {
            "type": "string"
          }
        },
        "required": [
          "agentSoul",
          "previousAgentSoul"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "inventory.replenishmentPlan",
      "title": "Plan inventory replenishment",
      "intent": "Calculate a deterministic replenishment plan from live stock, open reservations, recent sales, incoming purchase orders, and configured lead times without creating an order.",
      "module": "inventory",
      "risk": "read",
      "permission": "inventory.read",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "lookbackDays": {
            "type": "integer",
            "minimum": 7,
            "maximum": 365
          },
          "reviewDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 90
          },
          "leadTimeDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "serviceLevel": {
            "type": "string",
            "enum": [
              "90",
              "95",
              "98",
              "99"
            ]
          },
          "includeSufficient": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "assumptions": {
            "type": "object"
          },
          "summary": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "asOf",
          "currency",
          "assumptions",
          "summary",
          "items",
          "warnings",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
