    {
      "id": "accounting.createQuote",
      "title": "Create quote",
      "intent": "Draft a price quote for a customer with line items so they can accept it later and it becomes an invoice without retyping anything",
      "module": "accounting",
      "risk": "write",
      "permission": "accounting.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "accounting.declineQuote",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string"
          },
          "memo": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "thousandths of a unit; 1000 = one unit"
                },
                "unitPriceMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "taxMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "taxCodeId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "sku": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "Optional catalogue SKU; stock-backed lines carry the item into the sales order so confirmation can reserve it."
                }
              },
              "required": [
                "description",
                "quantity",
                "unitPriceMinor"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "customerId",
          "lines"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "string"
          },
          "quoteNumber": {
            "type": "number"
          },
          "totalMinor": {
            "type": "number"
          }
        },
        "required": [
          "quoteId",
          "quoteNumber",
          "totalMinor"
        ],
        "additionalProperties": false
      }
    },
