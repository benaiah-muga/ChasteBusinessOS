{
  "capabilities": [
    {
      "id": "crm.convertLead",
      "title": "Convert lead",
      "intent": "Promote a lead-stage deal to qualified and attach its customer, creating a customer record when requested.",
      "module": "crm",
      "risk": "write",
      "permission": "crm.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "crm.undoLeadConversion",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "dealId": { "type": "string", "format": "uuid" },
              "customerId": { "type": "string", "format": "uuid" }
            },
            "required": ["dealId", "customerId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "dealId": { "type": "string", "format": "uuid" },
              "createCustomer": { "type": "boolean", "const": true },
              "customerName": { "type": "string", "minLength": 1 }
            },
            "required": ["dealId", "createCustomer", "customerName"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "dealId": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "conversionIntentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "stage": { "type": "string", "const": "qualified" }
        },
        "required": ["dealId", "customerId", "conversionIntentId", "stage"],
        "additionalProperties": false
      }
    },
    {
      "id": "crm.undoLeadConversion",
      "title": "Undo lead conversion",
      "intent": "Restore a converted deal to its lead state and remove its unchanged unreferenced customer when safe.",
      "module": "crm",
      "risk": "destructive",
      "permission": "crm.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "crm.reapplyLeadConversion",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "conversionIntentId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["conversionIntentId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "undone": { "type": "boolean", "const": true },
          "dealId": { "type": "string", "format": "uuid" },
          "customerDeleted": { "type": "boolean" },
          "conversionIntentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "undoIntentId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["undone", "dealId", "customerDeleted", "conversionIntentId", "undoIntentId"],
        "additionalProperties": false
      }
    },
    {
      "id": "harness.listCompositions",
      "title": "List harness compositions",
      "intent": "Inspect an organization's immutable harness compositions and their safe profile, bundle, and configuration key metadata.",
      "module": "settings",
      "risk": "read",
      "permission": "harness.approve",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "compositions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "createdAt": { "type": "string", "format": "date-time" },
                "inspection": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "version": { "type": "string" },
                        "environment": { "type": "string" }
                      },
                      "required": ["id", "version", "environment"],
                      "additionalProperties": false
                    },
                    "profileDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "compositionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "bundles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "version": { "type": "string" },
                          "serviceIds": { "type": "array", "items": { "type": "string" } },
                          "requiredBundleIds": { "type": "array", "items": { "type": "string" } }
                        },
                        "required": ["id", "version", "serviceIds"],
                        "additionalProperties": false
                      }
                    },
                    "patches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "version": { "type": "string" },
                          "configKeys": { "type": "array", "items": { "type": "string" } }
                        },
                        "required": ["id", "version", "configKeys"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["profile", "profileDigest", "compositionDigest", "bundles", "patches"],
                  "additionalProperties": false
                }
              },
              "required": ["id", "createdAt", "inspection"],
              "additionalProperties": false
            }
          }
        },
        "required": ["compositions"],
        "additionalProperties": false
      }
    },
    {
      "id": "crm.reapplyLeadConversion",
      "title": "Reapply lead conversion",
      "intent": "Restore the exact lead conversion from its unchanged undo receipt, recreating the customer when required.",
      "module": "crm",
      "risk": "write",
      "permission": "crm.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "crm.undoLeadConversion",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "undoIntentId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["undoIntentId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "reapplied": { "type": "boolean", "const": true },
          "dealId": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "conversionIntentId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["reapplied", "dealId", "customerId", "conversionIntentId"],
        "additionalProperties": false
      }
    },
    {
      "id": "documents.allocateNumber",
      "title": "Allocate authored document number",
      "intent": "Reserve the next organization-scoped number for an authored business document.",
      "module": "documents",
      "risk": "write",
      "permission": "documents.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["invoice", "quote", "receipt", "delivery_note", "purchase_order", "voucher", "employment_contract", "employment_agreement"] }
        },
        "required": ["kind"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "number": { "type": "string", "minLength": 1 }
        },
        "required": ["number"],
        "additionalProperties": false
      }
    },
    {
      "id": "inventory.replenishmentPlan",
      "title": "Plan inventory replenishment",
      "intent": "Calculate a deterministic replenishment plan from live stock, open reservations, recent sales, incoming purchase orders, and configured lead times without creating an order.",
      "module": "inventory",
      "risk": "read",
      "permission": "inventory.read",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 120 },
          "lookbackDays": { "type": "integer", "minimum": 7, "maximum": 365 },
          "reviewDays": { "type": "integer", "minimum": 0, "maximum": 90 },
          "leadTimeDays": { "type": "integer", "minimum": 1, "maximum": 365 },
          "serviceLevel": { "type": "string", "enum": ["90", "95", "98", "99"] },
          "includeSufficient": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "asOf": { "type": "string" },
          "currency": { "type": "string" },
          "assumptions": { "type": "object" },
          "summary": { "type": "object" },
          "items": { "type": "array", "items": { "type": "object" } },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "truncated": { "type": "boolean" }
        },
        "required": ["asOf", "currency", "assumptions", "summary", "items", "warnings", "truncated"],
        "additionalProperties": false
      }
    },
    {
      "id": "purchasing.createPurchaseOrder",
      "title": "Create purchase order",
      "intent": "Commit an authorized purchase order with its vendor, lines, quantities, prices, and promised delivery date.",
      "module": "purchasing",
      "risk": "money",
      "permission": "purchasing.write",
      "executionScope": "organization",
      "moneyThresholdMinor": 0,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "vendorId": { "type": "string", "format": "uuid" },
          "memo": { "type": "string" },
          "promisedAt": { "type": "string", "format": "date-time" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "quantity": { "type": "integer" },
                "unitPriceMinor": { "type": "integer" },
                "expenseAccountCode": { "type": "string", "pattern": "^[0-9]{4}$" },
                "sku": { "type": "string" }
              },
              "required": ["description", "quantity", "unitPriceMinor"],
              "additionalProperties": false
            }
          }
        },
        "required": ["vendorId", "lines"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "poNumber": { "type": "integer" }
        },
        "required": ["poNumber"],
        "additionalProperties": false
      }
    },
    {
      "id": "purchasing.selectWinningQuote",
      "title": "Award purchase quote",
      "intent": "Select a quoted supplier as the winner and commit the resulting purchase order under purchase authority.",
      "module": "purchasing",
      "risk": "money",
      "permission": "purchasing.write",
      "executionScope": "organization",
      "moneyThresholdMinor": 0,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "rfqId": { "type": "string", "format": "uuid" }
        },
        "required": ["rfqId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "poNumber": { "type": "integer" },
          "vendorId": { "type": "string", "format": "uuid" },
          "quoteAmountMinor": { "type": "integer" }
        },
        "required": ["poNumber", "vendorId", "quoteAmountMinor"],
        "additionalProperties": false
      }
    },
    {
      "id": "purchasing.listVendors",
      "title": "List purchasing vendors",
      "intent": "List this organization's suppliers with contact details, payment terms, and active state for purchasing decisions.",
      "module": "purchasing",
      "risk": "read",
      "permission": "purchasing.read",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "includeInactive": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "vendors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "name": { "type": "string" },
                "email": { "type": ["string", "null"] },
                "paymentTermDays": { "type": ["integer", "null"] },
                "active": { "type": "boolean" }
              },
              "required": ["id", "name", "email", "paymentTermDays", "active"],
              "additionalProperties": false
            }
          }
        },
        "required": ["vendors"],
        "additionalProperties": false
      }
    },
    {
      "id": "purchasing.getPurchaseOrder",
      "title": "Read purchase order",
      "intent": "Read one purchase order with its status, ordered lines, received quantities, and receipt history for verification.",
      "module": "purchasing",
      "risk": "read",
      "permission": "purchasing.read",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "poNumber": { "type": "integer", "minimum": 1 }
        },
        "required": ["poNumber"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "poNumber": { "type": "integer" },
          "vendorId": { "type": "string", "format": "uuid" },
          "vendorName": { "type": "string" },
          "status": { "type": "string" },
          "memo": { "type": ["string", "null"] },
          "orderedAt": { "type": ["string", "null"] },
          "promisedAt": { "type": ["string", "null"] },
          "totalMinor": { "type": "integer" },
          "lines": { "type": "array", "items": { "type": "object" } },
          "receipts": { "type": "array", "items": { "type": "object" } },
          "fullyReceived": { "type": "boolean" },
          "backordered": { "type": "boolean" }
        },
        "required": ["poNumber", "vendorId", "vendorName", "status", "memo", "orderedAt", "promisedAt", "totalMinor", "lines", "receipts", "fullyReceived", "backordered"],
        "additionalProperties": false
      }
    }
  ]
}
