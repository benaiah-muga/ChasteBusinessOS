{
  "capabilities": [
    {
      "id": "crm.convertLead",
      "title": "Convert lead",
      "intent": "Promote a lead-stage deal to qualified and attach its customer, creating a customer record when requested.",
      "module": "crm",
      "risk": "write",
      "permission": "crm.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "crm.undoLeadConversion",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "dealId": { "type": "string", "format": "uuid" },
              "customerId": { "type": "string", "format": "uuid" }
            },
            "required": ["dealId", "customerId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "dealId": { "type": "string", "format": "uuid" },
              "createCustomer": { "type": "boolean", "const": true },
              "customerName": { "type": "string", "minLength": 1 }
            },
            "required": ["dealId", "createCustomer", "customerName"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "dealId": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "conversionIntentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "stage": { "type": "string", "const": "qualified" }
        },
        "required": ["dealId", "customerId", "conversionIntentId", "stage"],
        "additionalProperties": false
      }
    },
    {
      "id": "crm.undoLeadConversion",
      "title": "Undo lead conversion",
      "intent": "Restore a converted deal to its lead state and remove its unchanged unreferenced customer when safe.",
      "module": "crm",
      "risk": "destructive",
      "permission": "crm.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "crm.reapplyLeadConversion",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "conversionIntentId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["conversionIntentId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "undone": { "type": "boolean", "const": true },
          "dealId": { "type": "string", "format": "uuid" },
          "customerDeleted": { "type": "boolean" },
          "conversionIntentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "undoIntentId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["undone", "dealId", "customerDeleted", "conversionIntentId", "undoIntentId"],
        "additionalProperties": false
      }
    },
    {
      "id": "harness.listCompositions",
      "title": "List harness compositions",
      "intent": "Inspect an organization's immutable harness compositions and their safe profile, bundle, and configuration key metadata.",
      "module": "settings",
      "risk": "read",
      "permission": "harness.approve",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "compositions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "createdAt": { "type": "string", "format": "date-time" },
                "inspection": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "version": { "type": "string" },
                        "environment": { "type": "string" }
                      },
                      "required": ["id", "version", "environment"],
                      "additionalProperties": false
                    },
                    "profileDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "compositionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "bundles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "version": { "type": "string" },
                          "serviceIds": { "type": "array", "items": { "type": "string" } },
                          "requiredBundleIds": { "type": "array", "items": { "type": "string" } }
                        },
                        "required": ["id", "version", "serviceIds"],
                        "additionalProperties": false
                      }
                    },
                    "patches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "version": { "type": "string" },
                          "configKeys": { "type": "array", "items": { "type": "string" } }
                        },
                        "required": ["id", "version", "configKeys"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["profile", "profileDigest", "compositionDigest", "bundles", "patches"],
                  "additionalProperties": false
                }
              },
              "required": ["id", "createdAt", "inspection"],
              "additionalProperties": false
            }
          }
        },
        "required": ["compositions"],
        "additionalProperties": false
      }
    },
    {
      "id": "crm.reapplyLeadConversion",
      "title": "Reapply lead conversion",
      "intent": "Restore the exact lead conversion from its unchanged undo receipt, recreating the customer when required.",
      "module": "crm",
      "risk": "write",
      "permission": "crm.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": "crm.undoLeadConversion",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "undoIntentId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["undoIntentId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "reapplied": { "type": "boolean", "const": true },
          "dealId": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "conversionIntentId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["reapplied", "dealId", "customerId", "conversionIntentId"],
        "additionalProperties": false
      }
    },
    {
      "id": "documents.allocateNumber",
      "title": "Allocate authored document number",
      "intent": "Reserve the next organization-scoped number for an authored business document.",
      "module": "documents",
      "risk": "write",
      "permission": "documents.write",
      "executionScope": "organization",
      "moneyThresholdMinor": null,
      "inverseCapabilityId": null,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["invoice", "quote", "receipt", "delivery_note", "purchase_order", "voucher", "employment_contract", "employment_agreement"] }
        },
        "required": ["kind"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "number": { "type": "string", "minLength": 1 }
        },
        "required": ["number"],
        "additionalProperties": false
      }
    }
  ]
}
