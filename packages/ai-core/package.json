{
  "name": "@chaste/ai-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.0",
    "@chaste/config": "workspace:*",
    "@chaste/kernel": "workspace:*",
    "@chaste/ui-schema": "workspace:*",
    "@mastra/core": "^1.51.0",
    "@mastra/evals": "^1.5.1",
    "@mastra/mcp": "^1.14.0",
    "@mastra/memory": "^1.23.0",
    "@mastra/observability": "^1.16.1",
    "@mastra/pg": "^1.16.0",
    "@opentelemetry/api": "^1.9.1",
    "langfuse": "^3.38.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
